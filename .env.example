# Sentinel — Shannon Testnet (Chain ID 50312)
# Copy to .env and fill in private values. Never commit .env.

# --- Network ---
SOMNIA_CHAIN_ID=50312
SOMNIA_RPC_HTTP=https://api.infra.testnet.somnia.network/
SOMNIA_RPC_WSS=wss://api.infra.testnet.somnia.network/ws
SOMNIA_EXPLORER=https://shannon-explorer.somnia.network

# --- Somnia Native Agent Platform (Shannon Testnet) ---
# Verified from docs.somnia.network/agents/invoking-agents/from-solidity
SOMNIA_AGENTS_PLATFORM=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776

# Default subcommittee size (3) and timeout (15min) per docs.
# Per-agent minimum deposit: 0.01 STT. Total deposit for default 3-validator
# request varies by agent type. The Coordinator caches a per-request deposit
# value at deploy; see PER_REQUEST_DEPOSIT below.
SOMNIA_AGENT_SUBCOMMITTEE_SIZE=3
SOMNIA_AGENT_TIMEOUT_SECONDS=900

# Scorer / Router agent IDs. Initially these point to the base `llm-inference`
# agent ID. Once Discord confirms custom agent registration, these will be
# replaced with our domain-specific agent IDs (set via
# Coordinator.setScorerSomniaAgentId / setRouterSomniaAgentId).
SCORER_AGENT_ID=
ROUTER_AGENT_ID=

# --- Price Oracle (Protofire Chainlink-compatible feeds, Shannon Testnet) ---
ORACLE_ETH_USD=0x604CF5063eC760A78d1C089AA55dFf29B90937f9
ORACLE_BTC_USD=0x3dF17dbaa3BA861D03772b501ADB343B4326C676
ORACLE_USDC_USD=0xA4a08Eb26f85A53d40E3f908B406b2a69B1A2441

# --- Wallets (DO NOT COMMIT) ---
DEPLOYER_PRIVATE_KEY=
WATCHER_PRIVATE_KEY=
EXECUTOR_PRIVATE_KEY=

# --- Deploy script knobs (script/Deploy.s.sol) ---
# Optional. Each falls back to the documented default.
TREASURY_ADDRESS=
WETH_LT_BPS=7500
WETH_LB_BPS=500
WETH_CF_BPS=5000
USDC_CF_BPS=5000
REPUTATION_SUCCESS_REWARD=100
REPUTATION_FAILURE_PENALTY=50
AGENT_SHARE_BPS=6000
TREASURY_SHARE_BPS=3000
BOUNTY_SHARE_BPS=1000
SCORE_THRESHOLD=5000
PER_REQUEST_DEPOSIT=120000000000000000   # 0.12 ether (matches base llm-inference cost)
ORACLE_STALENESS_THRESHOLD=86400         # 1 day
# Testnet-only initial price overrides (USD scaled by 1e18). 0 = no override.
INITIAL_ETH_PRICE_USD18=3000000000000000000000
INITIAL_USDC_PRICE_USD18=1000000000000000000
WETH_FAUCET_CAP=100000000000000000000    # 100 WETH per public mint
USDC_FAUCET_CAP=100000000000               # 100k USDC per public mint
DEPLOY_DEMO_VAULT=true
VAULT_OWNER=
VAULT_METADATA_URI=ipfs://sentinel/vault/v1

# --- Sentinel deployed contracts (filled by deploy script output) ---
SENTINEL_AGENT_REGISTRY=
SENTINEL_REPUTATION=
SENTINEL_COORDINATOR=
SENTINEL_SPLITTER=
SENTINEL_LENDING_POOL=
SENTINEL_PRICE_ORACLE_ADAPTER=
SENTINEL_AUTO_PROTECTION_VAULT=

# --- Watcher runtime (packages/agents) ---
WATCHER_AGENT_ID=                 # the AgentRegistry ID this Watcher operates
WATCHER_HEALTH_THRESHOLD=1.05     # flag when on-chain HF drops below this
WATCHER_POLL_INTERVAL_MS=5000     # how often to scan active borrowers
WATCHER_START_BLOCK=0             # bootstrap from this block on first run

# --- Executor runtime (packages/agents) ---
EXECUTOR_AGENT_ID=                # the AgentRegistry ID this Executor operates
EXECUTOR_START_BLOCK=0            # bootstrap from this block on first run

# --- Logging ---
LOG_LEVEL=info
