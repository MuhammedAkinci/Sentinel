{
  "name": "@sentinel/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sentinel-watcher": "./dist/bin/watcher.js",
    "sentinel-executor": "./dist/bin/executor.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "watcher": "tsx src/bin/watcher.ts",
    "executor": "tsx src/bin/executor.ts",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@sentinel/shared": "*",
    "pino": "^9.5.0",
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
